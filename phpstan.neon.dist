parameters:
	paths:
		- CRM
		- tests
		- stoken.php
	excludePaths:
		analyse:
			- CRM/Stoken/DAO/*
			- tests/phpunit/bootstrap.php
	scanFiles:
		- stoken.civix.php
		- tools/phpunit/vendor/bin/.phpunit/phpunit/src/Framework/TestCase.php
		- phpstan-stubs/EventMessages.stub.php
	scanDirectories:
		- tools/phpunit/vendor/bin/.phpunit/phpunit/src/Framework
		- mixin
	bootstrapFiles:
		- tools/phpunit/vendor/bin/.phpunit/phpunit/vendor/autoload.php
		- phpstanBootstrap.php
	level: 9
	universalObjectCratesClasses:
		- Civi\Core\Event\GenericHookEvent
		- CRM_Core_Config
		- CRM_Core_DAO
		- civicrm_api3
	earlyTerminatingMethodCalls:
		CRM_Utils_System:
			- civiExit
			- redirect
		CRM_Queue_Runner:
			- runAllViaWeb
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	checkUninitializedProperties: true
	checkMissingCallableSignature: true
	treatPhpDocTypesAsCertain: false
	exceptions:
		check:
			missingCheckedExceptionInThrows: true
			tooWideThrowType: true
		checkedExceptionClasses:
			- \Webmozart\Assert\InvalidArgumentException
		implicitThrows: false
	ignoreErrors:
		# Note paths are prefixed with "*/" to work with inspections in PHPStorm because of:
		# https://youtrack.jetbrains.com/issue/WI-63891/PHPStan-ignoreErrors-configuration-isnt-working-with-inspections
		-
			message: '#^Call to function method_exists\(\) with Civi\\EventMessages\\MessageTokens and ''requiresToken'' will always evaluate to true\.$#'
			path: '*/CRM/Stoken/EventMessagesIntegration.php'
			count: 1
			# Deliberate version-compatibility check for the optional
			# de.systopia.eventmessages extension: our PHPStan stub only
			# reflects its current API shape, so PHPStan can't know that
			# older versions may lack requiresToken(). See phpstan-stubs/EventMessages.stub.php.
		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			path: '*/CRM/Stoken/AddressTokens.php'
			count: 1
			# Deliberately defensive: tokenValues() historically also accepts
			# $cids as a comma-separated string or as ['contact_id' => ...],
			# unlike the other token classes. Kept as-is on purpose; only the
			# parameter type was narrowed to array|string for PHPStan.
	tmpDir: .phpstan
